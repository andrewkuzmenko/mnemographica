{
	"name": "mnemographica",
	"displayName": "Mnemonica Graphica",
	"description": "Explore mnemonica type hierarchies: definitions, types, usages, execution flow and generations, with go-to-definition navigation",
	"version": "0.5.9",
	"publisher": "Mythographica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythographica/mnemographica.git"
	},
	"bugs": {
		"url": "https://github.com/mythographica/mnemographica/issues"
	},
	"homepage": "https://github.com/mythographica/mnemographica#readme",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Visualization",
		"Programming Languages"
	],
	"keywords": [
		"mnemonica",
		"inheritance",
		"prototype",
		"typescript",
		"visualization"
	],
	"activationEvents": [
		"workspaceContains:**/*.ts",
		"workspaceContains:**/package.json",
		"onView:mnemonicaLiveTrace",
		"onView:mnemonicaUsages",
		"onView:mnemonicaTypes",
		"onView:mnemonicaFlow",
		"onView:mnemonicaGen",
		"onView:mnemonicaDiamonds",
		"onView:mnemonicaBagels"
	],
	"main": "./out/src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "mnemographica.showTypeGraph",
				"title": "Ψ 3D",
				"category": "Mnemonica"
			},
			{
				"command": "mnemographica.openGraphInVR",
				"title": "Ψ 3D in VR (browser + WebXR)",
				"category": "Mnemonica"
			},
			{
				"command": "mnemographica.refreshGraph",
				"title": "Refresh Type Graph",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			},
			{
				"command": "mnemographica.refreshTree",
				"title": "Refresh Tree View",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			},
			{
				"command": "mnemographica.showTreeView",
				"title": "Show Tree View",
				"category": "Mnemonica",
				"icon": "$(list-tree)"
			},
			{
				"command": "mnemographica.showStrategyStatus",
				"title": "Show Strategy MCP Status",
				"category": "Mnemonica",
				"icon": "$(server-environment)"
			},
			{
				"command": "mnemographica.openStrategyTab",
				"title": "Ψ Strategy MCP",
				"category": "Mnemonica",
				"icon": "$(server-process)"
			},
			{
				"command": "mnemographica.openAppChannelTab",
				"title": "Ψ App Channel",
				"category": "Mnemonica",
				"icon": "$(plug)"
			},
			{
				"command": "mnemographica.openSettings",
				"title": "Ψ Settings",
				"category": "Mnemonica",
				"icon": "$(settings-gear)"
			},
			{
				"command": "mnemographica.showLogger",
				"title": "Show Logger",
				"category": "Mnemonica",
				"icon": "$(output)"
			},
			{
				"command": "mnemographica.openTreeItem",
				"title": "Open Definition",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.showUsages",
				"title": "Show Usages",
				"category": "Mnemonica",
				"icon": "$(references)"
			},
			{
				"command": "mnemographica.openUsage",
				"title": "Open Usage",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.navigateToUsage",
				"title": "Navigate to Usage",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.selectWorkspace",
				"title": "Select Workspace",
				"category": "Mnemonica",
				"icon": "$(folder)"
			},
			{
				"command": "mnemographica.revealInExplorer",
				"title": "Reveal in Explorer View",
				"category": "Mnemonica",
				"icon": "$(folder-opened)"
			},
			{
				"command": "mnemographica.goToUsage",
				"title": "Go to Usage",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.goToDefinition",
				"title": "Go to Definition",
				"category": "Mnemonica",
				"icon": "$(symbol-method)"
			},
			{
				"command": "mnemographica.navigateToLocation",
				"title": "Go to Location",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.showFlows",
				"title": "Show Flows",
				"category": "Mnemonica",
				"icon": "$(debug-alt)"
			},
			{
				"command": "mnemographica.clearFlowFilter",
				"title": "Show All Flows",
				"category": "Mnemonica",
				"icon": "$(clear-all)"
			},
			{
				"command": "mnemographica.showOnGraph",
				"title": "Show on Graph",
				"category": "Mnemonica",
				"icon": "$(graph)"
			},
			{
				"command": "mnemographica.refreshGenTree",
				"title": "Refresh By Generation",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			},
			{
				"command": "mnemographica.replayTrace",
				"title": "Replay Trace",
				"category": "Mnemonica",
				"icon": "$(run)"
			},
			{
				"command": "mnemographica.openJaegerTrace",
				"title": "Open in Jaeger",
				"category": "Mnemonica",
				"icon": "$(link-external)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "mnemographica.showTypeGraph"
				},
				{
					"command": "mnemographica.openGraphInVR"
				},
				{
					"command": "mnemographica.refreshGraph"
				},
				{
					"command": "mnemographica.refreshTree"
				},
				{
					"command": "mnemographica.showTreeView"
				},
				{
					"command": "mnemographica.showStrategyStatus"
				},
				{
					"command": "mnemographica.showLogger"
				},
				{
					"command": "mnemographica.selectWorkspace"
				},
				{
					"command": "mnemographica.refreshGenTree"
				}
			],
			"view/title": [
				{
					"command": "mnemographica.openAppChannelTab",
					"when": "view == mnemonicaLiveTrace",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.showTypeGraph",
					"when": "view == mnemonicaTypes",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.selectWorkspace",
					"when": "view == mnemonicaTypes",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.openSettings",
					"when": "view == mnemonicaUsages",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.clearFlowFilter",
					"when": "view == mnemonicaFlow",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.refreshGenTree",
					"when": "view == mnemonicaGen",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "mnemographica.openTreeItem",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.showOnGraph",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.showUsages",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@3"
				},
				{
					"command": "mnemographica.showFlows",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@4"
				},
				{
					"command": "mnemographica.revealInExplorer",
					"when": "view == mnemonicaUsages",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.goToUsage",
					"when": "view == mnemonicaUsages",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.goToDefinition",
					"when": "view == mnemonicaUsages",
					"group": "navigation@4"
				},
				{
					"command": "mnemographica.replayTrace",
					"when": "view == mnemonicaLiveTrace && viewItem =~ /^mnemTrace/",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.openJaegerTrace",
					"when": "view == mnemonicaLiveTrace && viewItem == mnemTraceJaeger",
					"group": "navigation@2"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mnemonica",
					"title": "Mnemonica",
					"icon": "media/psi-icon.svg"
				}
			]
		},
		"views": {
			"mnemonica": [
				{
					"id": "mnemonicaLiveTrace",
					"name": "Live Trace",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaUsages",
					"name": "Usages",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaTypes",
					"name": "Types",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaFlow",
					"name": "Flow",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaGen",
					"name": "By Generation",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaDiamonds",
					"name": "Diamonds",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaBagels",
					"name": "Bagels",
					"icon": "media/psi-icon.svg"
				}
			]
		},
		"outputChannels": [
			{
				"id": "mnemonicaLogger",
				"name": "Mnemonica Logger"
			}
		],
		"configuration": {
			"title": "Mnemonica Graphica",
			"properties": {
				"mnemographica.strategyLogPort": {
					"type": "number",
					"default": 9250,
					"description": "TCP port the spawned Strategy MCP child mirrors its logs to (STRATEGY_LOG_PORT; the Strategy tab reads it)"
				},
				"mnemographica.appChannelDiscoveryUrl": {
					"type": "string",
					"default": "http://127.0.0.1:3000/strategy/channel",
					"description": "Default discovery URL for the App Channel tab — an app's self-hosted strategy WS channel (startStrategyClient)"
				},
				"mnemographica.followTacticaChanges": {
					"type": "boolean",
					"default": false,
					"description": "Watch every open 3D graph's .tactica and rebuild the graph on regeneration"
				},
				"mnemographica.alwaysShowCollectionSelector": {
					"type": "boolean",
					"default": true,
					"description": "Show the 3D collection selector even when the project has a single collection, so the feature stays discoverable"
				},
				"mnemographica.invocationPathFilter": {
					"type": "string",
					"default": "\\.spec\\.ts|\\.test\\.ts|/tests?/|__tests__",
					"description": "RegExp over creation-scope file paths — matching scopes hide in the 3D graph. Empty string shows everything"
				},
				"mnemographica.usagesPathFilter": {
					"type": "string",
					"default": "",
					"description": "RegExp over usage file paths for the Usages tree — matching entries hide. Empty reuses the 3D graph's invocationPathFilter"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "npm run tactica:generate && rm -rf ./out && tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "node test/registry-loading.test.js && node test/types-model.test.js && node test/trace-ingest.test.js && node test/logger-channel.test.js && node test/graph-builder.test.js && node test/collections.test.js && node test/scene-builder.test.js && node test/registry-store.test.js && node test/vr-bridge.test.js",
		"package": "vsce package",
		"tactica:generate": "tactica --generate --verbose",
		"tactica:watch": "tactica --watch"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "1.74.0",
		"@types/ws": "^8.18.1",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^9.39.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	},
	"dependencies": {
		"@mnemonica/dive": "^0.10.4",
		"@mnemonica/lethe": "^0.2.2",
		"@mnemonica/strategy": "^0.5.3",
		"@mnemonica/tactica": "^0.4.8",
		"@mnemonica/topologica": "^0.1.0",
		"ajv": "^8.20.0",
		"mnemonica": "^1.4.2",
		"ws": "^8.22.0"
	}
}
